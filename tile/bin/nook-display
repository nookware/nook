#!/usr/bin/env bash
# nook-tile display switch, like Win+P / Plasma's Meta+P (here SUPER ⇧ P):
#   nook-display            toggle: extend ⇄ duplicate
#   nook-display duplicate  every other screen mirrors the focused one, all at the biggest
#                           resolution they share (so a small beamer gets a native picture)
#   nook-display duplicate 1280x720   the same at a resolution you pick
#   nook-display extend     back to the layout in ~/.config/hypr/machine.lua
#   nook-display only [OUT] only the focused screen (or OUT, e.g. the beamer), the others off
#   nook-display plugged    Hyprland runs this when a screen appears: a screen machine.lua doesn't
#                           know (a beamer, a TV) opens the picker (qs ipc: screens offer OUT)
#   nook-display unplugged  … and this when one goes: back to extend if screens were mirrored or
#                           off, so pulling the beamer's cable never leaves you without a picture
# Extend is just a config reload, so machine.lua stays the single source of the layout.
set -euo pipefail

notify() { notify-send -a nook -u low "$@" 2>/dev/null || true; }
mons() { hyprctl monitors all -j; }

mode=${1:-toggle}
if [ "$mode" = toggle ]; then
  # mirroring or switched off → extend, otherwise duplicate
  if mons | jq -e 'any(.[]; .mirrorOf != "none" or .disabled)' >/dev/null; then
    mode=extend
  else
    mode=duplicate
  fi
fi

src=$(hyprctl monitors -j | jq -r '(map(select(.focused)) + .)[0].name')

# screens already offered this session, so re-enabling one (extend after "only") doesn't ask again
seen=${XDG_RUNTIME_DIR:-/tmp}/nook-display.offered
# exists while the screens are not in the machine.lua layout (duplicate or only)
changed=${XDG_RUNTIME_DIR:-/tmp}/nook-display.changed
machine=${XDG_CONFIG_HOME:-$HOME/.config}/hypr/machine.lua
# screens with no rule of their own in machine.lua (by port name or desc:), one name per line
unknown() {
  mons | jq -r '.[] | "\(.name)\t\(.description)"' | while IFS=$'\t' read -r name desc; do
    grep -qF "output = \"$name\"" "$machine" 2>/dev/null && continue
    [ -n "$desc" ] && grep -qF "output = \"desc:$desc\"" "$machine" 2>/dev/null && continue
    echo "$name"
  done
}

case $mode in
  extend)
    hyprctl reload >/dev/null
    rm -f "$changed"
    notify "[~] extend" "screens side by side again"
    ;;
  duplicate|mirror)
    # one resolution for all screens: the biggest one every screen has (a small beamer gets a
    # native picture instead of a shrunken 1440p one), or the one given as $2, e.g. 1920x1080.
    # Extend (a reload) puts the source back to its mode from machine.lua.
    res=${2:-$(mons | jq -r --arg s "$src" '
          map(.availableModes | map(sub("@.*"; "")) | unique) as $sets
          | reduce $sets[1:][] as $x ($sets[0]; [.[] | select(. as $r | $x | index($r))])
          | sort_by(split("x") | map(tonumber) | .[0] * .[1]) | last // empty')}
    # best refresh a screen has at $res, empty if it doesn't have it
    best() { mons | jq -r --arg o "$1" --arg r "$res@" '
               .[] | select(.name == $o) | .availableModes | map(select(startswith($r)))
               | sort_by(sub(".*@"; "") | sub("Hz"; "") | tonumber) | last // empty | sub("Hz$"; "")'; }
    lua=""
    if [ -n "$res" ] && m=$(best "$src") && [ -n "$m" ]; then
      lua+=$(mons | jq -r --arg s "$src" --arg m "$m" '.[] | select(.name == $s)
             | "hl.monitor({ output = \"\(.name)\", mode = \"\($m)\", position = \"\(.x)x\(.y)\", scale = \(.scale), transform = \(.transform) })"')$'\n'
    fi
    while read -r out; do
      # each screen keeps its own rotation: a physically turned screen needs it to show the
      # picture upright (letterboxed when portrait mirrors landscape or the other way round)
      m=$(best "$out"); m=${m:-preferred}
      t=$(mons | jq -r --arg o "$out" '.[] | select(.name == $o) | .transform')
      lua+="hl.monitor({ output = \"$out\", mode = \"$m\", position = \"auto\", scale = 1, transform = $t, mirror = \"$src\" })
"
    done < <(mons | jq -r --arg s "$src" '.[] | select(.name != $s) | .name')
    [[ $lua == *mirror* ]] || { notify "[!] duplicate" "only one screen connected"; exit 0; }
    hyprctl eval "$lua" >/dev/null
    echo duplicate >"$changed"
    notify "[OK] duplicate ${res:-}" "all screens show $src · SUPER ⇧ P again to extend"
    ;;
  only)
    if [ -n "${2:-}" ]; then
      mons | jq -e --arg o "$2" 'any(.[]; .name == $o)' >/dev/null || { echo "no screen $2" >&2; exit 1; }
      src=$2
      # switch it on first, in case an earlier "only" switched it off
      mons | jq -e --arg o "$src" 'any(.[]; .name == $o and .disabled)' >/dev/null && { hyprctl reload >/dev/null; sleep 0.5; }
    fi
    lua=""
    while read -r out; do
      lua+="hl.monitor({ output = \"$out\", disabled = true })
"
    done < <(mons | jq -r --arg s "$src" '.[] | select(.name != $s) | .name')
    [ -n "$lua" ] && hyprctl eval "$lua" >/dev/null
    echo only >"$changed"
    notify "[OK] $src only" "the other screens are off · SUPER ⇧ P to extend"
    ;;
  plugged)
    touch "$seen"
    sleep 0.3   # let Hyprland finish setting the screen up
    for out in $(unknown); do
      grep -qxF "$out" "$seen" && continue
      echo "$out" >>"$seen"
      qs -c nook ipc call screens offer "$out" >/dev/null 2>&1 || notify "[+] new screen $out" "SUPER ⇧ P: duplicate, extend or only one"
    done
    ;;
  unplugged)
    present=$(mons | jq -r '.[].name')
    # forget screens that are gone, so plugging them in again asks again
    [ -f "$seen" ] && { grep -xF -f <(echo "$present") "$seen" >"$seen.new" || true; mv "$seen.new" "$seen"; }
    if [ -f "$changed" ] || mons | jq -e 'any(.[]; .mirrorOf != "none" or .disabled) or (map(select(.disabled | not)) | length == 0)' >/dev/null; then
      hyprctl reload >/dev/null
      rm -f "$changed"
      notify "[~] extend" "a screen was unplugged · back to the normal layout"
    fi
    qs -c nook ipc call screens gone >/dev/null 2>&1 || true
    ;;
  *) echo "usage: nook-display [toggle|duplicate [WxH]|extend|only [OUTPUT]|plugged|unplugged]" >&2; exit 2 ;;
esac
