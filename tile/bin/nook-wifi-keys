#!/usr/bin/python3 -I
"""nook-wifi-keys — move saved wifi passwords from KWallet into NetworkManager.

  nook-wifi-keys          migrate every wifi profile whose password is agent-owned
  nook-wifi-keys --check  only list those profiles

Profiles saved under Plasma keep their password in KWallet (psk-flags 1, agent-owned). Outside
Plasma no NetworkManager secret agent runs, so they fail with no-secrets. This reads each password
from the wallet folder "Network Management" and hands it to NetworkManager with psk-flags 0, so NM
stores it itself (root-only file) and every session can connect. Passwords go to nmcli on stdin,
never on a command line, and are never printed.
Only the Python standard library is used.
"""
import json
import logging
import subprocess
import sys

logger = logging.getLogger("nook-wifi-keys")

WALLET = "kdewallet"
WALLET_FOLDER = "Network Management"
AGENT_OWNED = "1"
COMMAND_TIMEOUT_SECONDS = 20


def run(arguments: list[str], stdin: str | None = None) -> str:
    """Run a command and return its stdout.

    Args:
        arguments: The command and its arguments.
        stdin: Text sent to the command's stdin.

    Returns:
        The command's stdout, stripped.

    Raises:
        subprocess.CalledProcessError: The command failed.
    """
    result = subprocess.run(arguments, input=stdin, capture_output=True, text=True, check=True, timeout=COMMAND_TIMEOUT_SECONDS)
    return result.stdout.strip()


def agent_owned_profiles() -> list[tuple[str, str]]:
    """List the wifi profiles whose password is kept by a secret agent.

    Returns:
        (uuid, name) pairs.
    """
    profiles = []
    for line in run(["nmcli", "-t", "-f", "UUID,TYPE,NAME", "connection", "show"]).splitlines():
        uuid, connection_type, name = line.split(":", 2)
        if connection_type != "802-11-wireless":
            continue
        flags = run(["nmcli", "-g", "802-11-wireless-security.psk-flags", "connection", "show", uuid])
        if flags == AGENT_OWNED:
            profiles.append((uuid, name.replace("\\:", ":")))
    return profiles


def wallet_password(uuid: str) -> str | None:
    """Read a profile's wifi password from KWallet.

    Args:
        uuid: The NetworkManager profile UUID.

    Returns:
        The password, or None if the wallet has none for this profile.
    """
    entry = f"{{{uuid}}};802-11-wireless-security"
    try:
        secrets = json.loads(run(["kwallet-query", "-r", entry, "-f", WALLET_FOLDER, WALLET]))
    except (subprocess.CalledProcessError, json.JSONDecodeError):
        return None
    password = secrets.get("psk") if isinstance(secrets, dict) else None
    if not password or "\n" in password:
        return None
    return password


def store_in_networkmanager(uuid: str, password: str) -> None:
    """Give NetworkManager the password and make it the owner.

    Args:
        uuid: The NetworkManager profile UUID.
        password: The wifi password.
    """
    run(["nmcli", "connection", "modify", "uuid", uuid, "802-11-wireless-security.psk-flags", "0"])
    commands = f"set 802-11-wireless-security.psk {password}\nsave\nquit\n"
    run(["nmcli", "connection", "edit", "uuid", uuid], stdin=commands)


def main() -> int:
    """Migrate (or with --check, list) the agent-owned wifi profiles."""
    logging.basicConfig(format="%(message)s", level=logging.INFO)
    check_only = "--check" in sys.argv[1:]
    failed = 0
    for uuid, name in agent_owned_profiles():
        if check_only:
            logger.info(f"agent-owned  {name}")
            continue
        password = wallet_password(uuid)
        if password is None:
            logger.warning(f"no wallet password  {name}  (type it once in SUPER N)")
            failed += 1
            continue
        try:
            store_in_networkmanager(uuid, password)
        except subprocess.CalledProcessError:
            logger.error(f"nmcli refused  {name}")
            failed += 1
            continue
        if run(["nmcli", "-g", "802-11-wireless-security.psk-flags", "connection", "show", uuid]) == AGENT_OWNED:
            logger.error(f"still agent-owned  {name}")
            failed += 1
        else:
            logger.info(f"moved  {name}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
